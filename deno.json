{
  "name": "@myty/rume-chat-workspace",
  "version": "0.0.0",
  "exports": {},
  "tasks": {
    "dev:web": "deno task --cwd ./apps/web dev",
    "dev:api": "deno task --cwd ./apps/api dev",
    "dev": {
      "command": "deno -V",
      "description": "Run API + App in development mode",
      "dependencies": [
        "dev:web",
        "dev:api"
      ]
    },
    "build": "deno task --filter @myty/rume-chat-web build",
    "start": "deno task --filter @myty/rume-chat-web start"
  },
  "imports": {
    "@biomejs/biome": "npm:@biomejs/biome@^2.3.3",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/http": "jsr:@std/http@^1.0.21",
    "@std/testing": "jsr:@std/testing@^1.0.16"
  },
  "workspace": [
    "./apps/api",
    "./apps/web",
    "./packages/domain",
    "./packages/ioc",
    "./packages/persistence",
    "./packages/github"
  ],
  "unstable": [
    "sloppy-imports"
  ],
  "fmt": {
    "jsx.bracketPosition": "sameLine",
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": ["no-sloppy-imports"]
    }
  },
  "nodeModulesDir": "auto"
}
